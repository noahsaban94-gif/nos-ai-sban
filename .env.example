# GEMINI_API_KEY: Required for Gemini AI API calls (Primary).
GEMINI_API_KEY=""
# GEMINI_API_KEY_2: Optional secondary key for auto-rotation on quota/rate limit.
GEMINI_API_KEY_2=""
# GEMINI_API_KEY_3: Optional tertiary key for auto-rotation on quota/rate limit.
GEMINI_API_KEY_3=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
